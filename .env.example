# ============================================================
# health-agent — environment variables
# ============================================================

# ----- Local dev only -----
# Used when running `npm run dev` outside the TEE.
# Falls back to mock LLM responses if neither this nor EIGEN_GATEWAY_URL is set.
ANTHROPIC_API_KEY=

# ----- Inside the TEE -----
# These are auto-injected by EigenCompute KMS at boot via compute-source-env.sh
# DO NOT set them in .env when deploying — leave them empty here.
#   MNEMONIC          — TEE-derived wallet mnemonic, also used for encryption key derivation
#   APP_ID            — set by EigenCompute, used for the verify URL

# ----- AI gateway (production, mainnet-alpha) -----
# When deploying to mainnet-alpha, this gets set so the LLM call is confidentially
# routed through the Eigen AI gateway. The provider never sees plaintext outside the TEE.
# VERIFY: confirm exact URL/auth flow with current Eigen docs before deploying.
EIGEN_GATEWAY_URL=
EIGEN_GATEWAY_TOKEN=
LLM_MODEL=anthropic/claude-sonnet-4-5

# ----- Storage -----
# Path inside the container for the encrypted SQLite file.
DATA_DIR=/data

# ----- Server -----
PORT=3000
